LangString FINISH_TITLE ${LANG_DUTCH} "FileSpacer is geïnstalleerd"
LangString FINISH_TEXT ${LANG_DUTCH} "De installatie is voltooid.$\r$\n$\r$\nKlik op Voltooien om deze wizard te sluiten."
