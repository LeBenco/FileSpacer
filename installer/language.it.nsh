; FileSpacer installer translations. UTF-8.
LangString SCOPE_TITLE ${LANG_ITALIAN} "Installa FileSpacer ${PRODUCT_VERSION}"
LangString BRANDING_SUBTITLE ${LANG_ITALIAN} "Gestore di file$\r$\nspaziale"
LangString SCOPE_SUBTITLE ${LANG_ITALIAN} "Scegli chi può usare FileSpacer."
LangString SCOPE_CURRENT ${LANG_ITALIAN} "Solo per me"
LangString SCOPE_ALL ${LANG_ITALIAN} "Tutti gli utenti (Windows chiederà conferma)"
LangString NOTES_TITLE ${LANG_ITALIAN} "Novità"
LangString FINISH_TITLE ${LANG_ITALIAN} "FileSpacer è stato installato"
LangString FINISH_TEXT ${LANG_ITALIAN} "L'installazione è completa.$\r$\n$\r$\nFai clic su Fine per chiudere la procedura guidata."
LangString FINISH_BUTTON ${LANG_ITALIAN} "Fine"
LangString ERROR_MACHINE ${LANG_ITALIAN} "Impossibile completare l'installazione per tutti gli utenti."
LangString SEC_START ${LANG_ITALIAN} "Collegamento nel menu Start"
LangString SEC_CONTEXT ${LANG_ITALIAN} "Menu contestuale delle cartelle"
LangString SEC_DEFAULT ${LANG_ITALIAN} "Imposta FileSpacer come gestore di file predefinito"
LangString DESC_BASE ${LANG_ITALIAN} "FileSpacer e le relative licenze."
LangString DESC_START ${LANG_ITALIAN} "Aggiunge FileSpacer al menu Start."
LangString DESC_CONTEXT ${LANG_ITALIAN} "Aggiunge al menu di cartelle e unità un comando per l'altro gestore di file: FileSpacer o Esplora file di Windows. È necessario per l'opzione del gestore predefinito, ma non la attiva."
LangString DESC_DEFAULT ${LANG_ITALIAN} "Apre cartelle e unità con FileSpacer anziché con Esplora file di Windows. Puoi attivare questa opzione in seguito o ripristinare Esplora file nelle impostazioni di FileSpacer, in Integrazione."
LangString CONTEXT_TEXT ${LANG_ITALIAN} "Apri in FileSpacer"
LangString CLOSE_TITLE ${LANG_ITALIAN} "Chiudi FileSpacer"
LangString CLOSE_TEXT ${LANG_ITALIAN} "Chiudi tutte le finestre di FileSpacer prima di continuare."
LangString ERROR_OS ${LANG_ITALIAN} "FileSpacer richiede Windows 10 o successivo a 64 bit."
LangString ERROR_INSTALL ${LANG_ITALIAN} "Installazione non riuscita. Chiudi FileSpacer e verifica l'accesso alla cartella di installazione."
LangString ERROR_DEFAULT ${LANG_ITALIAN} "Impossibile impostare FileSpacer come gestore di file predefinito. Riprova nelle impostazioni di FileSpacer, in Integrazione."
LangString ERROR_UNINSTALL ${LANG_ITALIAN} "Disinstallazione non riuscita. Chiudi FileSpacer e riprova."
LangString WARNING_UNINSTALL_DOCUMENTATION ${LANG_ITALIAN} "FileSpacer è stato disinstallato, ma non è stato possibile pulire la guida. I file della guida rimanenti e build-info.json sono stati conservati in $INSTDIR\help."
LangString ERROR_SCOPE ${LANG_ITALIAN} "Esiste già un'installazione con un ambito diverso. Mantieni l'ambito e il percorso attuali oppure disinstallala prima di cambiarli."
LangString MACHINE_WAIT ${LANG_ITALIAN} "Installazione per tutti gli utenti: conferma la richiesta di privilegi elevati di Windows e attendi il completamento del programma di installazione..."
LangString OPEN_LOG ${LANG_ITALIAN} "Aprire il registro di installazione?"
LangString ERROR_MACHINE_CLOSED ${LANG_ITALIAN} "FileSpacer o il suo provider di cartelle è ancora caricato in una sessione di questo computer. Chiudi FileSpacer in tutte le sessioni e riprova."
LangString ERROR_MACHINE_FILES ${LANG_ITALIAN} "Il programma di installazione con privilegi elevati non ha potuto copiare i file del programma. Verifica l'accesso alla cartella di installazione."
LangString ERROR_MACHINE_REGISTRY ${LANG_ITALIAN} "Il programma di installazione con privilegi elevati non ha potuto registrare il programma per tutti gli utenti."
LangString ERROR_MACHINE_SHORTCUT ${LANG_ITALIAN} "Il programma di installazione con privilegi elevati non ha potuto creare il collegamento nel menu Start."
LangString ERROR_MACHINE_CONTEXT ${LANG_ITALIAN} "Il programma di installazione con privilegi elevati non ha potuto registrare il menu contestuale delle cartelle."
LangString ERROR_MACHINE_OPTIONS ${LANG_ITALIAN} "Il programma di installazione con privilegi elevati non ha potuto salvare le opzioni di installazione."
