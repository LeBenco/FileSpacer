; FileSpacer installer translations. UTF-8.
LangString SCOPE_TITLE ${LANG_POLISH} "Zainstaluj FileSpacer ${PRODUCT_VERSION}"
LangString BRANDING_SUBTITLE ${LANG_POLISH} "Przestrzenny menedżer plików"
LangString SCOPE_SUBTITLE ${LANG_POLISH} "Wybierz, kto może używać FileSpacer."
LangString SCOPE_CURRENT ${LANG_POLISH} "Tylko dla mnie"
LangString SCOPE_ALL ${LANG_POLISH} "Wszyscy użytkownicy (Windows poprosi o potwierdzenie)"
LangString NOTES_TITLE ${LANG_POLISH} "Nowości"
LangString FINISH_TITLE ${LANG_POLISH} "FileSpacer został zainstalowany"
LangString FINISH_TEXT ${LANG_POLISH} "Instalacja zakończona.$\r$\n$\r$\nKliknij Zakończ, aby zamknąć kreatora."
LangString FINISH_BUTTON ${LANG_POLISH} "Zakończ"
LangString ERROR_MACHINE ${LANG_POLISH} "Nie można ukończyć instalacji dla wszystkich użytkowników."
LangString SEC_START ${LANG_POLISH} "Skrót w menu Start"
LangString SEC_CONTEXT ${LANG_POLISH} "Menu kontekstowe folderów"
LangString SEC_DEFAULT ${LANG_POLISH} "Ustaw FileSpacer jako domyślny menedżer plików"
LangString DESC_BASE ${LANG_POLISH} "FileSpacer i jego licencje."
LangString DESC_START ${LANG_POLISH} "Dodaj FileSpacer do menu Start."
LangString DESC_CONTEXT ${LANG_POLISH} "Dodaj polecenie menu folderów i dysków otwierające drugi menedżer: FileSpacer lub Eksplorator plików Windows. Wymagane dla opcji domyślnego menedżera; nie włącza jej."
LangString DESC_DEFAULT ${LANG_POLISH} "Otwieraj foldery i dyski w FileSpacer zamiast Eksploratora plików Windows. Możesz też włączyć tę opcję później lub przywrócić Eksplorator w ustawieniach FileSpacer, w Integracji."
LangString CONTEXT_TEXT ${LANG_POLISH} "Otwórz w FileSpacer"
LangString CLOSE_TITLE ${LANG_POLISH} "Zamknij FileSpacer"
LangString CLOSE_TEXT ${LANG_POLISH} "Zamknij wszystkie okna FileSpacer przed kontynuowaniem."
LangString ERROR_OS ${LANG_POLISH} "FileSpacer wymaga Windows 10 lub nowszego, 64-bitowego."
LangString ERROR_INSTALL ${LANG_POLISH} "Instalacja nie powiodła się. Zamknij FileSpacer i sprawdź dostęp do folderu instalacji."
LangString ERROR_DEFAULT ${LANG_POLISH} "Nie można ustawić FileSpacer jako domyślnego menedżera. Spróbuj ponownie w ustawieniach, w Integracji."
LangString ERROR_UNINSTALL ${LANG_POLISH} "Deinstalacja nie powiodła się. Zamknij FileSpacer i spróbuj ponownie."
LangString WARNING_UNINSTALL_DOCUMENTATION ${LANG_POLISH} "FileSpacer został odinstalowany, ale nie można wyczyścić pomocy. Pozostałe pliki i build-info.json zachowano w $INSTDIR\help."
LangString ERROR_SCOPE ${LANG_POLISH} "Instalacja istnieje już w innym trybie. Zachowaj tryb i lokalizację albo odinstaluj ją przed zmianą."
LangString MACHINE_WAIT ${LANG_POLISH} "Instalacja dla wszystkich: potwierdź żądanie podwyższenia Windows i poczekaj na zakończenie instalatora..."
LangString OPEN_LOG ${LANG_POLISH} "Otworzyć dziennik instalacji?"
LangString ERROR_MACHINE_CLOSED ${LANG_POLISH} "FileSpacer lub dostawca folderów nadal działa w sesji tego komputera. Zamknij FileSpacer we wszystkich sesjach i spróbuj ponownie."
LangString ERROR_MACHINE_FILES ${LANG_POLISH} "Podwyższony instalator nie mógł skopiować plików programu. Sprawdź dostęp do folderu instalacji."
LangString ERROR_MACHINE_REGISTRY ${LANG_POLISH} "Podwyższony instalator nie mógł zapisać rejestracji programu dla wszystkich użytkowników."
LangString ERROR_MACHINE_SHORTCUT ${LANG_POLISH} "Podwyższony instalator nie mógł utworzyć skrótu w menu Start."
LangString ERROR_MACHINE_CONTEXT ${LANG_POLISH} "Podwyższony instalator nie mógł zarejestrować menu kontekstowego folderów."
LangString ERROR_MACHINE_OPTIONS ${LANG_POLISH} "Podwyższony instalator nie mógł zapisać opcji instalacji."
