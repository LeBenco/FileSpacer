  PUSHBUTTON "Annuler", IDCANCEL, 362, 280, 48, 14
END

IDD_FOLDER_GROUPS DIALOGEX 0, 0, 300, 211
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Groupes de dossiers"
FONT 8, "MS Shell Dlg", 400, 0, 0
BEGIN
  LTEXT "Ouvre les dossiers d’un groupe avec leur disposition enregistrée, en conservant les autres fenêtres.", -1, 10, 10, 280, 24
  LISTBOX IDC_GROUPS_LIST, 10, 37, 280, 94, LBS_NOTIFY | WS_BORDER | WS_VSCROLL | WS_TABSTOP
  LTEXT "&Nom du groupe :", -1, 10, 141, 80, 9
  EDITTEXT IDC_GROUPS_NAME, 94, 137, 196, 14, ES_AUTOHSCROLL | WS_TABSTOP
  PUSHBUTTON "&Enregistrer les dossiers ouverts", IDC_GROUPS_SAVE, 10, 160, 166, 15
  PUSHBUTTON "&Supprimer", IDC_GROUPS_DELETE, 185, 160, 105, 15
  DEFPUSHBUTTON "&Rappeler", IDC_GROUPS_RECALL, 132, 188, 76, 15
  PUSHBUTTON "Fermer", IDCANCEL, 214, 188, 76, 15
END
