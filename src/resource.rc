#include <windows.h>
#include "resource.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

1 VERSIONINFO
    FILEVERSION     FILESPACER_VERSION
    PRODUCTVERSION  FILESPACER_VERSION
    FILEOS          VOS_NT_WINDOWS32
    FILETYPE        VFT_APP
{
    BLOCK "StringFileInfo" {
        BLOCK "040904B0" {
            VALUE "CompanyName", "FileSpacer\0"
            VALUE "FileDescription", "FileSpacer\0"
            VALUE "FileVersion", FILESPACER_VERSION_STRING
            VALUE "LegalCopyright", "Copyright (c) 2026 LeBenco; original ChromaFiler (c) 2023 J. van't Hoog\0"
            VALUE "ProductName", "FileSpacer\0"
            VALUE "ProductVersion", FILESPACER_VERSION_STRING
        }
    }
    BLOCK "VarFileInfo" {
        VALUE "Translation", 0x0409, 0x04B0
    }
}

IDR_RT_MANIFEST1 RT_MANIFEST "res\\FileSpacer.exe.manifest"

IDR_APP_ICON    ICON    "res\\FileSpacer.ico"


IDR_ITEM_ACCEL  ACCELERATORS {
    VK_UP,          IDM_PREV_WINDOW,    VIRTKEY, ALT
    VK_UP,          IDM_PREV_WINDOW,    VIRTKEY, ALT, CONTROL
    "W",            IDM_CLOSE_WINDOW,   VIRTKEY, CONTROL
    VK_F5,          IDM_REFRESH,        VIRTKEY
    "R",            IDM_REFRESH,        VIRTKEY, CONTROL
    // VK_F1,          IDM_HELP,           VIRTKEY // Deferred public help.
    VK_OEM_COMMA,   IDM_SETTINGS,       VIRTKEY, CONTROL
    VK_TAB,         IDM_PARENT_MENU,    VIRTKEY, CONTROL, SHIFT
    VK_F1,          IDM_DEBUG_NAMES,    VIRTKEY, CONTROL
    // proxy operations
    VK_F10,         IDM_PROXY_MENU,     VIRTKEY
    VK_F2,          IDM_RENAME_PROXY,   VIRTKEY, SHIFT
    "D",            IDM_DELETE_PROXY,   VIRTKEY, CONTROL, SHIFT
    // folder
    "N",            IDM_NEW_FOLDER,     VIRTKEY, CONTROL, SHIFT
    "N",            IDM_NEW_TEXT_FILE,  VIRTKEY, CONTROL
}

#pragma code_page(65001)

#include "resource.en.rc"
#include "dialog.en.rc"
#include "resource.fr.rc"
#include "dialog.fr.rc"
