    IDS_RESET_FOLDER_STATE_SUCCESS, "Zresetowano zapisane położenia, rozmiary i ustawienia widoku folderów. Ustawienia aplikacji zachowano."
    IDS_FOLDER_WIDTH_LABEL,   "S&zerokość (min: %1!d! px):"
