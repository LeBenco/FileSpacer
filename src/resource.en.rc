    IDS_RESET_FOLDER_STATE_CLOSE_ERROR, "Unable to close all FileSpacer windows. A window may have refused to close or may not be responding. No saved folder state was deleted. Some windows may already have closed."
    IDS_RESET_FOLDER_STATE_STORAGE_ERROR, "Unable to open the folder state database. No saved folder state was deleted."
    IDS_RESET_FOLDER_STATE_DELETE_ERROR, "Unable to reset the folder state database. The deletion was not committed."
