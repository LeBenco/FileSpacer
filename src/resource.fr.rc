    IDS_VIEW_COMMAND,       "Affichage..."

    IDS_FOLDER_STATUS,          "%1!d! éléments"
    IDS_FOLDER_STATUS_SEL,      "%1!d! éléments    %2!d! sélectionnés"
    IDS_FOLDER_STATUS_SEL_SIZE, "%1!d! éléments    %2!d! sélectionnés    %3!s!"
    IDS_FOLDER_ERROR,       "Impossible d'ouvrir le dossier"

    IDS_SUCCESS_CAPTION,    "Opération réussie"
    IDS_CONFIRM_CAPTION,    "Confirmation"
    IDS_RESET_FOLDER_STATE_CONFIRM, "Réinitialiser toutes les positions, tailles et options d'affichage mémorisées des dossiers ? Les fenêtres de dossiers de FileSpacer seront fermées et ne seront pas rouvertes automatiquement. Les paramètres de l'application seront conservés."
    IDS_RESET_FOLDER_STATE_CLOSE_ERROR, "Impossible de fermer toutes les fenêtres de FileSpacer. Une fenêtre a peut-être refusé de se fermer ou ne répond plus. Aucun état mémorisé des dossiers n'a été supprimé. Certaines fenêtres ont peut-être déjà été fermées."
    IDS_RESET_FOLDER_STATE_STORAGE_ERROR, "Impossible d'ouvrir la base des états de dossiers. Aucun état mémorisé des dossiers n'a été supprimé."
    IDS_RESET_FOLDER_STATE_DELETE_ERROR, "Impossible de réinitialiser la base des états de dossiers. La suppression n'a pas été validée."
    IDS_RESET_FOLDER_STATE_SUCCESS, "Les positions, tailles et options d'affichage mémorisées des dossiers ont été réinitialisées. Les paramètres de l'application ont été conservés."
    IDS_FOLDER_WIDTH_LABEL,   "&Largeur (min : %1!d! px) :"
    IDS_FOLDER_HEIGHT_LABEL,  "&Hauteur (min : %1!d! px) :"
    IDS_FOLDER_WIDTH_INVALID, "La largeur doit être un nombre entier d’au moins %1!d! px."
    IDS_FOLDER_HEIGHT_INVALID,"La hauteur doit être un nombre entier d’au moins %1!d! px."
    IDS_FOLDER_STATE_ERROR, "FileSpacer n’a pas pu lire ou enregistrer la base des états de dossiers. Vérifiez que le dossier des données locales de l’application est accessible en écriture et que la base est disponible. Les données existantes n’ont pas été réinitialisées."
    IDS_BROWSER_SET_FAILED, "Impossible de modifier l'explorateur de fichiers par défaut"
    IDS_BROWSER_DIRECTORY, "Dossiers"
    IDS_BROWSER_COMPRESSED_FOLDER, "Dossiers compressés (ZIP)"
    IDS_BROWSER_DRIVE, "Lecteurs"
    IDS_BROWSER_ASSOCIATION_ERROR, "%1 : %3 (erreur %2!lu!)"
    IDS_BROWSER_ASSOCIATIONS_FAILED, "Les associations suivantes n’ont pas pu être modifiées :\n\n%1\n\nToute modification réussie a été conservée."
    IDS_BROWSER_SET,        "FileSpacer est désormais votre explorateur de fichiers par défaut. Vous pouvez annuler ce changement dans les paramètres de FileSpacer."
    IDS_BROWSER_RESET,      "L'Explorateur de fichiers Windows est de nouveau votre explorateur par défaut."
    IDS_REQUIRE_CONTEXT,    "FileSpacer doit être installé avec l'option de menu contextuel des dossiers activée pour pouvoir modifier l'explorateur par défaut."
    IDS_BROWSER_SET_CONFIRM,"FileSpacer remplacera l'Explorateur de fichiers Windows comme programme par défaut pour ouvrir tous les dossiers."

    IDS_WELCOME_HEADER,     "Bienvenue"
    IDS_WELCOME_BODY,       "Il semble que vous utilisiez FileSpacer pour la première fois."
